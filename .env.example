# Leave unset to run the deterministic paper book.
# Set it to a deployed Omer.sol address to switch the whole interface to live reads.
VITE_OMER_ADDRESS=

# Tag verifikasi kepemilikan Virtuals Protocol. Disisipkan ke index.html
# saat build. Kosong berarti tag tidak dipasang.
VITE_VIRTUALS_VERIFICATION=
